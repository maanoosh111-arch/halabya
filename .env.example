# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CHEF_PIN: Secret PIN for accessing the private /chef dashboard.
CHEF_PIN=

# GOOGLE_SPREADSHEET_ID: Public Google Spreadsheet ID for product catalog sync.
GOOGLE_SPREADSHEET_ID="1lc3syoXJeRRk4BzfE52bShFhLtlfCJmQkND8p9gAEwM"

# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY: Optional Supabase persistence configuration.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WHATSAPP_RELAY_URL & WHATSAPP_RELAY_SECRET: Server-side med-link WhatsApp notification webhook.
WHATSAPP_RELAY_URL=
WHATSAPP_RELAY_SECRET=

# CORS_ORIGIN: Optional comma-separated origins allowed when static frontend (public/) is hosted separately.
CORS_ORIGIN=
